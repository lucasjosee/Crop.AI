# Ambiente
NODE_ENV=development
PORT=3000

# Banco de Dados
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/your_db_name

# Autenticação
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# LLM API (a chave deve corresponder ao provider selecionado)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_ID=gemini-2.5-flash

# S3 / MinIO (dev = MinIO local; prod = AWS S3 real, omitir S3_ENDPOINT)
# Para testar com celular físico, use o IP da LAN em vez de localhost
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password
S3_BUCKET=plant-diagnostics
