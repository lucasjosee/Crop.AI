# Ambiente
NODE_ENV=development
PORT=3000

# Banco de Dados
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/your_db_name

# Autenticação (32+ caracteres em produção: openssl rand -hex 32)
# Access token de 15 min e refresh de 30 dias, fixos no código
JWT_SECRET=your_jwt_secret_here

# LLM API (a chave deve corresponder ao provider selecionado)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_ID=gemini-2.5-flash

# S3 / MinIO (dev = MinIO local; prod = AWS S3 real, omitir S3_ENDPOINT)
# O mesmo endereço assina o upload (aparelho) e baixa a imagem da segunda
# opinião (backend), então precisa servir aos dois lados:
#   emulador: localhost, com `adb reverse tcp:9000 tcp:9000` (nunca 10.0.2.2)
#   celular físico pela rede: o IP da LAN
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password
S3_BUCKET=plant-diagnostics
